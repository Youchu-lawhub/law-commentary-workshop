{
  "schema_version": 1,
  "name": "中文法学期刊默认版式",
  "source": {
    "type": "preset",
    "reference": "中文法学期刊通用排版规范（默认预设）",
    "accessed": "2026-10-31"
  },
  "page": {
    "size": "A4",
    "width_mm": 210,
    "height_mm": 297,
    "margins_cm": {
      "top": 2.54,
      "bottom": 2.54,
      "left": 3.17,
      "right": 3.17
    }
  },
  "fonts": {
    "east_asia": "宋体",
    "latin": "Times New Roman",
    "title": "黑体",
    "author": "楷体",
    "quote": "楷体"
  },
  "title": {
    "font": "黑体",
    "size_pt": 22,
    "bold": true,
    "alignment": "center"
  },
  "body": {
    "size_pt": 10.5,
    "line_spacing": 1.25,
    "first_line_indent_chars": 2,
    "alignment": "justify",
    "space_before_pt": 0,
    "space_after_pt": 0
  },
  "headings": {
    "1": {
      "font": "宋体",
      "size_pt": 14,
      "bold": true,
      "alignment": "center",
      "before_lines": 0.5,
      "after_lines": 0.5
    },
    "2": {
      "font": "宋体",
      "size_pt": 12,
      "bold": false,
      "alignment": "left",
      "before_lines": 0.3,
      "after_lines": 0.3
    },
    "3": {
      "font": "宋体",
      "size_pt": 10.5,
      "bold": false,
      "alignment": "left",
      "before_lines": 0.2,
      "after_lines": 0.2
    },
    "4": {
      "font": "宋体",
      "size_pt": 10.5,
      "bold": false,
      "alignment": "left",
      "before_lines": 0.2,
      "after_lines": 0.2
    },
    "5": {
      "font": "宋体",
      "size_pt": 10.5,
      "bold": false,
      "alignment": "left",
      "before_lines": 0.2,
      "after_lines": 0.2
    }
  },
  "abstract": {
    "font": "楷体",
    "size_pt": 10.5,
    "label_bold": true,
    "line_spacing": 1.0
  },
  "keywords": {
    "font": "楷体",
    "size_pt": 10.5,
    "label_bold": true,
    "separator_spaces": 3,
    "line_spacing": 1.0
  },
  "author": {
    "font": "楷体",
    "size_pt": 14,
    "alignment": "center"
  },
  "footnote": {
    "font": "宋体",
    "size_pt": 9,
    "line_spacing": 1.0
  },
  "quote": {
    "font": "楷体",
    "size_pt": 10.5,
    "left_indent_chars": 1,
    "right_indent_chars": 1,
    "line_spacing": 1.0
  },
  "paragraph_codes": {
    "format": "【N】",
    "standalone": false,
    "bold": false
  },
  "reference_docx": "assets/templates/journal-cn.docx",
  "notes": [
    "标题层级与字号以本配置为准；目标期刊上传要求优先于本预设。",
    "字体名称为 Word 中的中文字体名；导出机缺少对应字体时须替换并复查渲染。"
  ]
}
